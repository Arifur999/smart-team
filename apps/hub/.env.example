# Postgres from the root docker-compose.yml
DATABASE_URL=postgresql://smart_team:smart_team@localhost:5433/smart_team

# Shared secret every node agent sends when it connects. At least 24 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=

PORT=4000
# Where the dashboard runs, for CORS
DASHBOARD_ORIGIN=http://localhost:3000
