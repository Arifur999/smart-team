# Postgres. `npm run serve` (or `npm run db`) runs it on this PC without Docker, on this port, with data in data/postgres.
# Using the root docker-compose.yml instead? Its port is 5433.
DATABASE_URL=postgresql://smart_team:smart_team@localhost:5434/smart_team

# Shared secret every node agent sends when it connects. At least 24 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=

PORT=4000
# Pages allowed to call the hub from a browser. "private" allows any dashboard opened from this PC, the LAN or
# Tailscale and keeps public websites out. Or list origins, separated by commas.
DASHBOARD_ORIGIN=private

# Optional. Folders of Claude Code skills on this PC that teams may use, separated by ";" on Windows.
# Defaults to your own ~/.claude/skills. Skills in the repo's skill-packs/skills always win.
SKILL_DIRS=
# Optional. Defaults to ../../skill-packs from apps/hub.
SKILL_PACKS_DIR=

# Command bot (Jarvis). Claude API key from https://platform.claude.com; it stays on this PC and is never sent
# to the browser. Leave empty to switch the bot off. API usage is billed separately from your Claude plan.
ANTHROPIC_API_KEY=
# Only for keys that are not scoped to one workspace: the workspace id (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Optional. Model and effort (low, medium, high, xhigh, max) the bot uses.
BOT_MODEL=claude-opus-5-5
BOT_EFFORT=medium
