generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum ResourceKind {
  TOOL
  FOLDER
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum Team {
  nextDev
  nextEditor
  nextDesign
  NextMarketer
}

/// INTAKE checks the brief and PLAN plans, both read-only; EXECUTE only starts after you approve a plan.
enum RunMode {
  INTAKE
  PLAN
  EXECUTE
}

/// Where the intake for a task stands. LOCKED means the brief is confirmed and planning started.
enum IntakePhase {
  ASKING
  REVIEWING
  CLARIFYING
  READY
  LOCKED
}

enum Speaker {
  FRIDAY
  YOU
}

/// WORK: a member makes something. GATE: a member judges it. CHECK: you decide.
enum StepKind {
  WORK
  GATE
  CHECK
}

/// ACTIVE: a run is queued, going, or paused for a usage limit. WAITING: needs you.
enum StepStatus {
  ACTIVE
  WAITING
  DONE
  SENT_BACK
  SKIPPED
  FAILED
  CANCELLED
}

enum DeliverableKind {
  VIDEO
  IMAGE
  AUDIO
  TEXT
  OTHER
}

/// UPLOAD: stored on the hub. PATH: a file or folder on one of the PCs. LINK: a URL.
enum AssetKind {
  UPLOAD
  PATH
  LINK
}

/// One PC running the node agent. `name` is the agent's stable identity across reconnects.
model Device {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String       @unique
  hostname     String
  ip           String?
  platform     String
  agentVersion String
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime     @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  resources Resource[]
  runs      Run[]
  tasks     Task[]
  assets    Asset[]

  @@index([status, lastSeenAt])
  @@map("devices")
}

/// What a PC offers. Replaced as a whole every time its agent registers.
model Resource {
  id        String       @id @default(uuid(7)) @db.Uuid
  deviceId  String       @db.Uuid
  kind      ResourceKind
  name      String
  path      String?
  version   String?
  tags      String[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, kind])
  @@map("resources")
}

/// What you asked for. Each follow-up instruction (and later, each revision) adds a run.
model Task {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Tasks from before teams existed were all development work, hence the default.
  team      Team     @default(nextDev)
  title     String
  /// Where the task runs. Set at creation, before any run exists; older tasks were backfilled from their first run.
  deviceId  String?  @db.Uuid
  workDir   String?
  /// Production line key, e.g. "nextEditor.video". Null: plan -> approve -> execute (older tasks, teams not on a line yet).
  line         String?
  /// Your choices for the line (direction, trust, pass mark, fixes, stages off, extra checks), filled in when it starts.
  lineSettings Json      @default("{}")
  /// The task's own folder inside workDir, e.g. "20261107-naxified-motion-0d66".
  folder       String?
  /// Set while a stage waits for a Claude usage limit to reset.
  resumeAt     DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  device   Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  runs     Run[]
  brief    Brief?
  messages IntakeMessage[]
  assets       Asset[]
  steps        LineStep[]
  deliverables Deliverable[]

  @@index([createdAt])
  @@index([team, createdAt])
  @@index([deviceId])
  @@map("tasks")
}

/// What the intake agent collected. Tasks from before intake existed have no brief.
model Brief {
  id             String      @id @default(uuid(7)) @db.Uuid
  taskId         String      @unique @db.Uuid
  phase          IntakePhase @default(ASKING)
  /// Field id -> typed answer.
  answers        Json        @default("{}")
  /// Optional fields you chose to skip.
  skipped        String[]    @default([])
  /// The field the intake agent is asking about now.
  currentFieldId String?
  /// Clear brief written by the review, handed to the planner once confirmed.
  summary        String?
  reviewRounds   Int         @default(0)
  lockedAt       DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("briefs")
}

/// One line of the intake chat.
model IntakeMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  taskId    String   @db.Uuid
  speaker   Speaker
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("intake_messages")
}

/// A file given for a brief field.
model Asset {
  id         String    @id @default(uuid(7)) @db.Uuid
  taskId     String    @db.Uuid
  fieldId    String
  kind       AssetKind
  name       String
  tag        String?
  /// PATH: the file or folder on `device`.
  path       String?
  deviceId   String?   @db.Uuid
  url        String?
  /// UPLOAD: file name inside the hub's upload folder.
  storageKey String?
  size       BigInt?
  mime       String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([taskId, fieldId])
  @@index([deviceId])
  @@map("assets")
}

/// One Claude Code session on one PC. A device runs one at a time; the rest wait as QUEUED.
model Run {
  id         String    @id @default(uuid(7)) @db.Uuid
  taskId     String    @db.Uuid
  deviceId   String    @db.Uuid
  workDir    String
  /// The instruction this run carries out.
  prompt     String
  mode       RunMode
  status     RunStatus @default(QUEUED)
  /// Claude Code session id, reported by the agent; follow-ups resume it.
  sessionId  String?
  /// Team member credited with the run, e.g. "maria-hill". Null for runs from before members were tracked.
  agentId    String?
  /// Running token totals reported by the agent.
  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)
  /// Claude's final answer, or why the run failed.
  outcome    String?
  costUsd    Decimal?  @db.Decimal(12, 6)
  startedAt  DateTime? @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  /// The production-line step this run works on. Null for intake checks and plan/execute tasks.
  stepId          String?   @db.Uuid
  stage           String?
  /// 1 for a step's first try; automatic retries count up.
  attempt         Int       @default(1)
  /// Line runs choose the session to continue when they are queued; other runs pick it when claimed.
  resumeSessionId String?
  /// What the agent is told for a line run (persona, access, task folder, files): RunRole plus skill keys.
  role            Json?
  /// Why the run failed, as a kind: usage-limit, max-turns, timeout, agent-lost, agent-outdated, error.
  failure         String?
  /// The agent's check after the run: missing files, saved reply, uploads, reset time.
  report          Json?
  /// When the line acted on this run's end. Finished line runs without it are picked up again.
  routedAt        DateTime? @db.Timestamptz(3)

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  step         LineStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  logs         RunLog[]
  deliverables Deliverable[]

  @@index([stepId, createdAt])
  @@index([taskId, createdAt])
  @@index([deviceId, status, createdAt])
  @@index([agentId, status])
  @@map("runs")
}

/// One pass of a task through one stage of its production line: a member's work, a gate's verdict or your check.
model LineStep {
  id         String     @id @default(uuid(7)) @db.Uuid
  taskId     String     @db.Uuid
  stage      String
  kind       StepKind
  /// Member credited, e.g. "beast"; "you" for your checks.
  ownerId    String
  /// 1 the first time the task reaches this stage, then 2, 3… Version folders use it (v2).
  round      Int
  status     StepStatus
  /// line | fix | recheck | triage
  reason     String     @default("line")
  /// What this step must address: FixNote[].
  notes      Json       @default("[]")
  /// The stage's parsed report (work) or verdict (gate).
  result     Json?
  score      Int?
  /// Short text for later stages' prompts and the line board.
  summary    String?
  /// On a step that sent work back: { stages, notes, rejoin }.
  route      Json?
  /// Your words when you decided, or why the step was skipped or is waiting.
  comment    String?
  /// "you" when you decided the outcome, else the member id.
  decidedBy  String?
  /// The step whose send-back this step is part of.
  causedById String?    @db.Uuid
  startedAt  DateTime   @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  causedBy     LineStep?     @relation("StepCause", fields: [causedById], references: [id], onDelete: SetNull)
  caused       LineStep[]    @relation("StepCause")
  runs         Run[]
  deliverables Deliverable[]

  @@index([taskId, createdAt])
  @@map("line_steps")
}

/// A file an agent uploaded from a task's folder for the Review Booth. The same path uploaded again is a new version.
model Deliverable {
  id         String          @id @default(uuid(7)) @db.Uuid
  taskId     String          @db.Uuid
  stepId     String?         @db.Uuid
  runId      String?         @db.Uuid
  stage      String
  /// Path inside the task folder, e.g. "04-renders/v2/film.mp4".
  path       String
  version    Int
  kind       DeliverableKind
  label      String?
  /// File name in DELIVERABLES_DIR.
  storageKey String          @unique
  size       BigInt
  mime       String
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step LineStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  run  Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([taskId, path, version])
  @@index([stepId])
  @@map("deliverables")
}

/// One line of a run's live log. `seq` comes from the agent and orders the lines.
model RunLog {
  id    String   @id @default(uuid(7)) @db.Uuid
  runId String   @db.Uuid
  seq   Int
  kind  String
  text  String
  at    DateTime @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("run_logs")
}
enum BotRole {
  YOU
  BOT
}

/// One message in the command bot chat. Stored so every dashboard (PC or phone) sees the same conversation.
model BotMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  role      BotRole
  text      String
  /// The team the message was about (an @mention or the selected team), if any.
  team      Team?
  /// Cards under the message: tasks the bot created and actions waiting for your confirmation.
  actions   Json     @default("[]")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("bot_messages")
}