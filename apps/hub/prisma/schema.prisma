generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum ResourceKind {
  TOOL
  FOLDER
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// PLAN runs in Claude Code's read-only plan mode; EXECUTE only starts after you approve a plan.
enum RunMode {
  PLAN
  EXECUTE
}

/// One PC running the node agent. `name` is the agent's stable identity across reconnects.
model Device {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String       @unique
  hostname     String
  ip           String?
  platform     String
  agentVersion String
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime     @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  resources Resource[]
  runs      Run[]

  @@index([status, lastSeenAt])
  @@map("devices")
}

/// What a PC offers. Replaced as a whole every time its agent registers.
model Resource {
  id        String       @id @default(uuid(7)) @db.Uuid
  deviceId  String       @db.Uuid
  kind      ResourceKind
  name      String
  path      String?
  version   String?
  tags      String[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, kind])
  @@map("resources")
}

/// What you asked for. Each follow-up instruction (and later, each revision) adds a run.
model Task {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  runs Run[]

  @@index([createdAt])
  @@map("tasks")
}

/// One Claude Code session on one PC. A device runs one at a time; the rest wait as QUEUED.
model Run {
  id         String    @id @default(uuid(7)) @db.Uuid
  taskId     String    @db.Uuid
  deviceId   String    @db.Uuid
  workDir    String
  /// The instruction this run carries out.
  prompt     String
  mode       RunMode
  status     RunStatus @default(QUEUED)
  /// Claude Code session id, reported by the agent; follow-ups resume it.
  sessionId  String?
  /// Claude's final answer, or why the run failed.
  outcome    String?
  costUsd    Decimal?  @db.Decimal(12, 6)
  startedAt  DateTime? @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  logs   RunLog[]

  @@index([taskId, createdAt])
  @@index([deviceId, status, createdAt])
  @@map("runs")
}

/// One line of a run's live log. `seq` comes from the agent and orders the lines.
model RunLog {
  id    String   @id @default(uuid(7)) @db.Uuid
  runId String   @db.Uuid
  seq   Int
  kind  String
  text  String
  at    DateTime @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("run_logs")
}